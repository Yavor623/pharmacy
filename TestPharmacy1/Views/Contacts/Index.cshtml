@model Contact

<main>
	<a class="btn btn-primary" asp-action="Edit">Edit</a>
	<h2>Контакти</h2>
	@if (@ViewBag.IsThereAny == false)
	{
		<p>Телефон: </p>
		<p>Имейл: </p>
	}
	else
	{
		<p>Телефон: @Model.Phone</p>
		<p>Имейл: @Model.Email</p>
	}
</main>
<style>
	main {
		margin: 10% 10% 0 10%;
	}
</style>
