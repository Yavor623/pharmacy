@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@model TestPharmacy1.Models.Medications.DetailsMedicationViewModel
@{
	var isPrescriptionNeeded = Model.IsPrescriptionNeeded == true ? "да" : "не";
	var car = ViewBag.Prescription;
	var type = ViewBag.TypeOfMedication;
	var consistency = ViewBag.ConsistencyOfMedication;
	var s = 5;
}
<div id="everything">
	<h2style ="justify-self:center">@ViewBag.Prescription</h2style>
	<h2 style="justify-self:center">Детайли</h2>
	<br />
	<div style="display:grid;grid-template-columns:1fr 1fr">
		<div>
			<img src="data:image;base64,@(Convert.ToBase64String(Model.Image))" style="max-width:95%;min-width:75%;max-height:95%;min-height:75%;border-radius:1rem" />
		</div>
		<div id="info">
			<div style="width:10%;" >
				<h3>@Model.Name</h3>
				<h4 style="font-weight:650;color:lawngreen">@Model.Price лв.</h4>
				<div style="width:100%">
					<form asp-action="AddToCart" method="post">
						<input type="number" min="1" max="@Model.Amount" name="amount" value="1" />
						<input type="hidden" name="medId" value="@Model.Id" />
						<input type="hidden" name="userId" value="@SignInManager.UserManager.GetUserId(User)" />
						<input type="submit" value="Добави в кошницата" class="btn btn-primary" />
					</form>
				</div>
			</div>
			<div style="width:100%;grid-column:2/ span 1" id="addInfo">
				<h4>Вид: </h4>
				<p>@consistency.Name</p>
				<h4>Класификация: </h4>
				<p>@type.Name</p>
				<h4>Начин на употреба:</h4>
				<p>@Model.HowToUse</p>
				<br />
				<h4>Описание:</h4>
				<p>@Model.Description</p>
				<br />
				<h5>Има ли нужда от предписание? - <p>@isPrescriptionNeeded</p></h5>
			</div>
		</div>
	</div>
</div>
<style>
	#info div{
		padding:3%;
		margin-bottom:5%;
	}

	#everything{
		margin:0 10% 0 10%;
	}
</style>