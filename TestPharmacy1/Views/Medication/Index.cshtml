@model IEnumerable<Medication>
@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<head>
    <link rel="stylesheet" href="~/css/Main.css"><link /> 
    <script src="https://kit.fontawesome.com/a28800c3e2.js" crossorigin="anonymous"></script>    
</head>

<aside class="left-aside">
    <h2>Страни</h2>
    <form asp-action="Index" method="get" class="searchId">
        <input name="searchString" value="" type="text" class="searchBar"/>
        <input type="submit" value="Search" class="searchBtn"/>
        <br />
        <label>Sort by:</label>
        <select name="selectedOption">
            <option></option>
            <option>Price</option>
            <option>Name</option>
        </select>
        
        <input type="submit" value="Order"  /> 
    </form>   
    <br />
    <a asp-action="Create" class="btn btn-primary">Create</a>
</aside>
<main>
        <h2 id="title">Продукти</h2>
        <div class="medications" style="margin-left:3%">

            @foreach (var medication in Model)
            {
                <div class="items">
                    
                    <div id="pop-up" style="display:none">
                        <ul>
                            <li><a asp-action="Delete">Delete</a></li>
                            <li><a asp-action="Edit">Edit</a></li>
                        </ul>
                    </div>
                    <div style="width:100%">

                    <label class="three-dots" >&#8230;<input type="checkbox" onclick="" name="toggle" id="toggle" /></label>
                        <div id="pic-frame">
                            <a asp-action="Details" asp-route-id="@medication.Id"><img src="data:image;base64,@(Convert.ToBase64String(@medication.Image))" style="border-radius:1rem;" /></a>
                        </div>
                        <div style="min-height:50px"><h5 style="font-weight:350">@medication.Name @medication.Description</h5></div>
                        <div style="min-height:50px"><h5 style="font-weight:650;color:lawngreen">@medication.Price лв.</h5></div>
                    </div>
                </div>
            }
        
        </div>
        <style>
            #pic-frame{
                width:100%;
                object-fit:cover;
                margin-bottom:3%;
                img{
                    width:100%;
                    min-height:140px;
                    max-height: 140px;
                }
            }
            #toggle{
                display:none;
            }
        #toggle:checked #pop-up {
            display: block;
        }
        </style>
