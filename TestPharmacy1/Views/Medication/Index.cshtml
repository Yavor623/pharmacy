@model IEnumerable<Medication>
@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<head>
    <link rel="stylesheet" href="~/css/Main.css"><link />    
</head>
<aside class="left-aside">
    <h2>Страни</h2>
    <form asp-action="Index" method="get" class="searchId">
        <input name="SearchString" value="" type="text" class="searchBar"/>
        <input type="submit" value="Search" class="searchBtn"/>
        <br />
        <label>Sort by:</label>
        <select name="SelectedOption">
            <option></option>
            <option>Price</option>
            <option>Name</option>
        </select>
        
        <input type="submit" value="Order"  /> 
    </form>   
    <a asp-action="Create" class="btn btn-primary">Create</a>
</aside>
<main>
        <h2 id="title">Продукти</h2>
        <div class="medications">

            @foreach (var medication in Model)
            {
                <div class="items">
                    
                <div class="pop-up" style="display:none">
                    <ul>
                        <li><a asp-action="Delete">Delete</a></li>
                        <li><a asp-action="Edit">Edit</a></li>
                    </ul>
                </div>
                <div>
                    <input onchange="ShowMenu()" type="checkbox" id="toggle" style="display:none" class="check">
                    <label for="toggle" class="three-dots">&#8230;</label>
                    <img src="data:image;base64,@(Convert.ToBase64String(@medication.Image))" width="100%" height="65%" style="border-radius:inherit" />
                    <h5 style="font-weight:300">@medication.Name @medication.Description</h5>
                    <h3 style="font-weight:650;color:greenyellow">@medication.Price лв.</h3>
                </div>
                </div>
            }
        
        </div>
    <script type="text/javascript">
        const checkBox = document.getElementById('toggle');
        const popUp = document.getElementsByClassName('pop-up')[0];
        function ShowMenu(){
            if(checkBox.ariaChecked){
                popUp.style.display = 'block';
            }
        }
    </script>
</main>


