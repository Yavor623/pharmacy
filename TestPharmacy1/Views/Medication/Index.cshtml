@model IEnumerable<Medication>
@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@{
    int currentPage = ViewBag.CurrentPage;
    int lastPage = currentPage-1;
    int nextPage = currentPage==0?currentPage+2:currentPage+1;
    int elementsToTake = ViewBag.AmountOfItems;
    int amountOfPages = (int)Math.Ceiling(Convert.ToDouble(Model.Count()) / elementsToTake);
    var takenElements = Model.Skip((currentPage-1)*elementsToTake).Take(elementsToTake).ToList();
}
@section Scripts{ 
    <script type="text/javascript" >
        function ClearValues() {
            $("#filterSelect").prop("disabled", false);
            $("#searchBar").prop("disabled", false);
            $("#sortDropdown").prop("disabled", false);
            sessionStorage.setItem("FilterValue", "Избери опция");
            sessionStorage.setItem("SortValue", "Избери опция");
            $("#hiddenSelect").hide();
            $("#searchBar").val(" ");
            sessionStorage.setItem("IsThereAddFilter", "false");
            $("#sortDropdown").val("Избери опция");
            $("#filterSelect").val("Избери опция");
            $("#sortDirection").val("desc");
            $('.sortDirectionBtn-wrap span').text('↓');
            sessionStorage.setItem("IsItAQuery", "false");
            sessionStorage.setItem("SearchValue", $("#searchBar").val());  
            sessionStorage.setItem("SortDirection", $("#sortDirection").val());
            
        }
        $(function () {
            $('.sortDirectionBtn-wrap').click(function () {
                var checked = $("#sortDirectionBtn").is(':checked');
                $('span', this).text(checked ? '↓' : '↑');
                $("#sortDirection").val(checked ? "desc" : "asc");
            });
            if(sessionStorage.getItem("IsItAQuery") == "true")
            {
                $("#checkIf").prop('checked', true);
                
            }
            else{
                $("#checkIf").prop('checked', false);
            }
            let checked = $("#checkIf").is(':checked');
            if (!checked) {
                ClearValues();
            }
            else 
            {
                $("#doneBtn input").prop('checked', false);
                sessionStorage.setItem("IsItAQuery", "false");
            }
            $("#filterSelect").val(sessionStorage.getItem("FilterValue"));
            $("#searchBar").val(sessionStorage.getItem("SearchValue"));
            $("#sortDropdown").val(sessionStorage.getItem("SortValue"));
            $("#sortDirection").val(sessionStorage.getItem("SortDirection"));
            $('.sortDirectionBtn-wrap span').text(sessionStorage.getItem("SortDirection") == "desc" ? '↓' : '↑');
            if (sessionStorage.getItem("IsThereAddFilter") == "true") {
                FillOutSelect();
                $("#hiddenSelect option[value=" + sessionStorage.getItem("AdditionalFilter") + "]").prop("selected", true);
            }
            
            $("#hiddenSelect").hide();

            $("select#selects option[value=" + elementsToTake + "]").prop("selected", true);
        });
        function ShouldItBeDeleted() {
            if (confirm("Да се изтрие ли този медикамент?")) {
                $("#confirm").val("Yes");
            }
            else {
                $("#confirm").val("No");
            }
        }
        function AmountOfItems(){
            $("#submitBtn").val($("#selects").find(":selected").val());
            $("#radio").prop('checked', true);
            $("#submitBtn").click();
        }
        function SaveValues() 
        {
            if($("#hiddenSelect").children().length==0){
                sessionStorage.setItem("IsThereAddFilter","false");
            }
            $("#checkIf").prop("checked", true);
            sessionStorage.setItem("IsItAQuery", "true");
            sessionStorage.setItem("SearchValue", $("#searchBar").val());
            sessionStorage.setItem("SortValue", $("#sortDropdown option:selected").val());
            sessionStorage.setItem("SortDirection", $("#sortDirection").val());
            sessionStorage.setItem("FilterValue", $("#filterSelect option:selected").val());
            sessionStorage.setItem("AdditionalFilter",$("#hiddenSelect option:selected").val());
        }
        function CheckIfSortIsSelected(){
            if($("#sortDropdown :selected").text()!="Избери опция"){
                $("#filterSelect").prop("disabled", true);
                $("#searchBar").prop("disabled", true);
            }
            else{
                $("#filterSelect").prop("disabled", false);
                $("#searchBar").prop("disabled", false);
            }
        }
        function CheckIfFilterIsSelected() {
            if ($("#filterSelect :selected").text() != "Избери опция") {
                $("#sortDropdown").prop("disabled", true);
                $("#searchBar").prop("disabled", true);
            }
                    else {
                $("#sortDropdown").prop("disabled", false);
                $("#searchBar").prop("disabled", false);
            }
        }
        function CheckIfThereIsSearch() {
            if ($("#searchBar").val() != "") {
                $("#filterSelect").prop("disabled", true);
                $("#sortDropdown").prop("disabled", true);
            }
                    else {
                $("#filterSelect").prop("disabled", false);
                $("#sortDropdown").prop("disabled", false);
            }
        }

        function FillOutSelect(){
            CheckIfFilterIsSelected();
            $("#hiddenSelect").hide();
            $("#hiddenSelect").empty();
            if ($("#filterSelect :selected").text() == "Класификация") {
                $("#hiddenSelect").show();
                sessionStorage.setItem("IsThereAddFilter","true");
                $.ajax({
                    type: 'GET',
                    dataType: 'JSON',
                    url: '/Medication/GetTypeOfMedication',
                    contentType: 'application/json;charset=utf-8',
                    success:function(response){
                        for (var i = 0; i < response.length; i++) {
                            $("#hiddenSelect").append('<option value="'+response[i]+'">'+response[i]+'</option>');
                        }
                    }
                });
               
            }
            else if ($("#filterSelect :selected").text() == "Вид медикамент") {
                $("#hiddenSelect").show();
                sessionStorage.setItem("IsThereAddFilter","true");
                $.ajax({
                    type: 'GET',
                    dataType: 'JSON',
                    url: '/Medication/GetConsistencyOfMedication',
                    contentType: 'application/json;charset=utf-8',
                    success: function (response) {
                        for (var i = 0; i < response.length; i++) {
                            $("#hiddenSelect").append('<option value="' + response[i] + '" style="min-width:100px;max-width:200px">' + response[i] + '</option>');
                        }
                    }
                });

            }
            }
    </script>

}
<head>
    <link rel="stylesheet" href="~/css/Main.css"><link /> 
    <script src="https://kit.fontawesome.com/a28800c3e2.js" crossorigin="anonymous"></script>  

</head>

<aside class="left-aside">
    <form asp-action="Index" method="get" id="optionsForm">
        <br />
        <div>
            <label>Сортирай по:</label>
            <br />
            <div>
                <select name="sortString" id="sortDropdown" onchange="CheckIfSortIsSelected()">
                    <option value="Избери опция" disabled selected>Избери опция</option>
                    <option>И двете</option>
                    <option>Цена</option>
                    <option>Име</option>
                </select>
            
                <label class="sortDirectionBtn-wrap">
                    <input type="checkbox" id="sortDirectionBtn" style="visibility:hidden" />
                    <span style="font-size:1.3rem">↓</span>
                </label>
                <input type="hidden" value="desc" id="sortDirection" name="direction" />
            </div>
            
        </div>
        <br />
        <div>
            <label>Филтрирай по:</label>
            <br />
            <select id="filterSelect" name="filter" onchange="FillOutSelect()" >
                <option value="Избери опция" disabled selected>Избери опция</option>
                <option>Има нужда от предписание</option>
                <option>Няма нужда от предписание</option>
                <option>Класификация</option>
                <option>Вид медикамент</option>
            </select>
        </div>
        <br />
        <div class="divWrapper">
            <select id="hiddenSelect" name="additionalFilter">
                
            </select>
        </div>
        <br />
        <button type="submit"  class="btn btn-primary" onclick="SaveValues()" asp-route-IsItAQuery="true">
             Готово 
            
        </button>
        <input type="checkbox" style="visibility:hidden" id="checkIf" />
        <input type="button" value="Изчисти" onclick="ClearValues()" class="btn btn-secondary"/>
    </form>   
    <br />
    
</aside>
<main>
    <form asp-action="Index" method="get" >
        <input name="searchString" value="" type="text" id="searchBar" onchange="CheckIfThereIsSearch()" />
        <button type="submit" id="searchBtn" onclick="SaveValues()" style="height:10%;border:none;border-radius:4px">
            <i class="fa-solid fa-magnifying-glass fa-xs"></i>
        </button>
    </form>
    
    <h2 id="title">Продукти</h2>
    <form asp-action="Index">
        <select id="selects" onchange="AmountOfItems()">
            <option value="8">8</option>
            <option value="12">12</option>
            <option value="16">16</option>
            <option value="20">20</option>
            <option value="24">24</option>
            <option value="@Model.Count()">All</option>
        </select>
        <input type="radio" name="isItChecked" id="radio" value="true" style="visibility:hidden" />
        <input type="submit" value="" id="submitBtn" class="btn btn-primary" name="submitValue" style="visibility:hidden"/>
    </form>
     @if (SignInManager.IsSignedIn(User)&&User.IsInRole("Admin"))
    {<a asp-action="Create" class="btn btn-primary">+</a>}
    <div class="medications" style="margin-left:3%">

        @foreach (var medication in takenElements)
        {

            <div class="items" >
                <div style="width:100%;height:50%">

                    <div id="pic-frame">
                        <a asp-action="Details" asp-route-id="@medication.Id" asp-route-prescriptionMessage=""><img src="data:image;base64,@(Convert.ToBase64String(@medication.Image))" style="border-radius:1rem;" /></a>
                    </div>
                    <div style="min-height:50px"><h5 style="font-weight:350">@medication.Name @medication.Description</h5></div>
                    <div style="min-height:50px"><h5 style="font-weight:650;color:lawngreen">@medication.Price лв.</h5></div>
                    @if (SignInManager.IsSignedIn(User)&&User.IsInRole("Admin"))
                    {
                        <div id="pop-up" style="justify-self:center" >
                            <form asp-action="Delete" method="post">
                                <input type="hidden" name="confirmed_value" id="confirm" />
                                <input type="submit" asp-route-id="@medication.Id" onclick="ShouldItBeDeleted()" asp-action="Delete" value="Delete" class="btn btn-danger"/>
                            </form>
                            <a asp-action="Edit" asp-route-id="@medication.Id" class="btn btn-secondary">Edit</a>
                        </div>
                    }
                </div>
            </div>
        }
        
        @if (amountOfPages > 1)
        {
            <form id="list_form" asp-action="Index">
                @if (ViewBag.CurrentPage > 1)
                {
                    <input type="hidden" value="@lastPage" name="id">
                    <input type="submit"  value="&lt;">
                }
                @for (int i = 1; i <= amountOfPages; i++)
                {
                    <input type="submit" value="@i" name="id">
                }
                @if (ViewBag.CurrentPage < amountOfPages||ViewBag.CurrentPage == 1)
                {
                    <input type="hidden" value="@nextPage" name="id">
                    <input type="submit" value="&gt;">
                }        
            </form>
        }
    </div>
        <style>
        body {
            overflow-x: hidden;
        }

        :root {
            --margin-left-main: 25vw;
            --margin-left-aside: 1vw;
            --main-width: 70vw;
            --height: 80vh;
        }

        #optionsForm {
            width: 100%;
            margin: 0;
            height: 40%;
            * :not(.sortDirectionBtn-wrap)

        {
            margin: 5% 5% 5% 0;
            min-width: 80%;
            max-width: 95%;
            font-size: 1.3rem;
        }

        }
        @@ media only screen and (max-width:1100px){
            .medications{
                grid-template-columns:1fr 1fr 1fr;
            }
        }
         @@ media only screen and (max-width:800px){
            .medications{
                grid-template-columns:1fr 1fr;
            }
        }

        @@ media only screen and (max-width:500px) {
            .medications {
                grid-template-columns: 1fr;
            }
        }
        a {
            text-decoration: none;
        }

        #pic-frame {
            width: 100%;
            object-fit: cover;
            margin-bottom: 3%;
        }

        #searchBar {
            border-radius: 7px;
            border: 1px solid gray;
            margin: 0;
            width: 70%;
            padding: 1%;
            font-size: 1.3em;
        }


        .left-aside {
            position: relative;
            float: left;
            margin-left: var(--margin-left-aside);
            width: calc(var( --margin-left-main) - calc(2* var(--margin-left-aside)));
            z-index: 1;
            height: var(--height);
            border: 1px solid black;
            border-radius:4px;
            padding: 1%;
        }

        main {
            margin-top: 5vh;
            width: var(--main-width);
            height: var(--height);
            padding: 3%;
            margin: 0;
            margin: 0 0 0 var( --margin-left-main);
            padding: 0;
            overflow-x: hidden;
            scroll-behavior: smooth;
            overflow-y: scroll;
            *

        {
            margin: 0;
            padding: 0;
        }

        }

        #title {
            margin: 10vh 0 5vh 20vw;
        }

        .medications {
            width: 95%;
            height: 100%;
            display: grid;
            grid-template-columns: 1fr 1fr 1fr 1fr;
        }

        .items {
            height: 100%;
            width: 85%;
            padding: 5%;
        }

            .items:hover {
                border: 1px solid black;
                border-radius: 7px;
            }
        .sortDirectionBtn-wrap{
            margin:0;
            height:10%;
            width:5%;
            user-select:none;
            span{
                margin:0;
            }
            sele
        }
        body{
            overflow:hidden
        }
            #list_form *{
               height:40px;
               width:40px;
               border-radius:7px;
               border:3px solid #5ed91c;
               background-color:#66f21b;
               color:white;
               font-weight:600;
               font-size:1.5em;
               text-align:center;
            }
            #pic-frame{
                width:100%;
                object-fit:cover;
                margin-bottom:3%;
                img{
                    width:100%;
                    min-height:140px;
                    max-height: 140px;
                }
            }
            .active{
                color:black;
            }
            #optionsForm *{
                user-select:none;
            }
        .divWrapper {
            width: 95%;
            overflow: hidden;
        }

        #hiddenSelect {
            width: 100%;
        }

            #hiddenSelect:focus {
                width: auto;
            }
        
        </style>
</main>


