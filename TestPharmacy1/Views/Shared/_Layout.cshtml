<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Fastmacy</title>
    <script src="https://kit.fontawesome.com/a28800c3e2.js" crossorigin="anonymous"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TestPharmacy1.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar theme-navbar navbar-expand-sm navbar-toggleable-sm border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index" style="max-width:10%;text-decoration:none;color:white"><img src="~/icon/bg,f8f8f8-flat,750x,075,f-pad,750x1000,f8f8f8[1].png" style="max-width:35%;max-height:35%"/>Fastmacy</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1 navUL">
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-area="" asp-controller="Home" asp-action="Index">Начало</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-area="" asp-controller="AboutUs" asp-action="Index">За_нас</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-area="" asp-controller="Contacts" asp-action="Index">Контакти</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-area="" asp-controller="Prescription" asp-action="Index">Предписание</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-area="" asp-controller="Medication" asp-action="Index">Медикамент</a>
                        </li>
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-link text-light" id="li-dropdown">
                                Администратор
                                <ul class="dropdown-menu">
                                    <li> <a class="nav-link text-dark" asp-area="" asp-controller="Account" asp-action="Index">Потребители</a></li>
                                </ul>
                            </li>
                        }

                    </ul>
                        <div>
                            <a asp-controller="ShoppingCart" asp-action="Index" style="text-decoration:none;color:black;">
                                <i class="fa-solid fa-cart-shopping fa-xl"></i>
                            </a>
                        </div>
                        <partial name="_LoginPartial" />
                    
                    
                </div>
            </div>
        </nav>
    </header>
    <style>
        .navUL li{
            font-size:1.1rem;
            
        }
        .navUL{
            text-align:center;
        }
        .theme-navbar{
            background-color: rgb(58, 191,25);
            text-align: center;
            *:not(.dropdown-menu){
                margin:0.5% 4% 0.5% 0;
            }
        }
        #li-dropdown ul li:hover{
           background-color:darkgray;
           color:darkslategray;
        }
        #li-dropdown:hover ul{
            display:block;
        }
        #dropdown{
            position:absolute;
            z-index:999;
            display:none;
            background-color: rgba(220,220,220,0,4);
            li:hover{
                background-color: rgba(220,220,220,0,8);
            }
            li{
                list-style:none;
            }
            
        }
    </style>
    <div>
            @RenderBody()
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
