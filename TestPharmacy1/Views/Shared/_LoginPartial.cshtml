@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager


<ul class="navbar-nav regLog">
@if (SignInManager.IsSignedIn(User))
{
        <form class="form-inline" asp-controller="Account" asp-action="Logout">
            <button type="submit" class="nav-link btn btn-danger">Logout</button>
        </form>
}
else
{
    <li class="nav-item">
        <button class="nav-link text-light btn-primary" asp-controller="Account" asp-action="Register">Register</button>
    </li>
    <li class="nav-item">
        <a class="nav-link text-light btn btn-danger" asp-controller="Account" asp-action="Login">Login</a>
    </li>
}
</ul>
<style>
    .regLog li a {
        font-size:1.2rem;
    }

    #userIcon:hover #dropdown {
        display:block;
    }
</style>