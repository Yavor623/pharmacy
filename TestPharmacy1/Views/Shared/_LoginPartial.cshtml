@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager


<ul class="navbar-nav regLog">
    <li style="margin:2% 3% 0 0">
        <a asp-controller="ShoppingCart" asp-action="Index" style="text-decoration:none;color:black;">
            <i class="fa-solid fa-cart-shopping fa-xl"></i>
        </a>
    </li>
@if (SignInManager.IsSignedIn(User))
{
    
        <li class="nav-item">
            <a class="btn btn-danger" asp-controller="Account" asp-action="Logout">Logout</a>
        </li>
}
else
{
    <li class="nav-item">
        <a class="btn btn-primary" asp-controller="Account" asp-action="Register">Register</a>
    </li>
    <li class="nav-item">
        <a class="btn btn-danger" asp-controller="Account" asp-action="Login">Login</a>
    </li>
}
</ul>
<style>
    .regLog li a {
        font-size:1.2rem;
    }

    #userIcon:hover #dropdown {
        display:block;
    }
</style>