@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager
@model IEnumerable<ApplicationUser>
@section Scripts{
	<script type="text/javascript">
		function ShouldItBeDeleted() {
			if (confirm("Да се изтрие ли този акаунт?")) {
				$("#confirm").val("Yes");
			}
			else {
				$("#confirm").val("No");
			}
		}
	</script>
}
<main>
	<h2 style="justify-self:center">Потребители</h2>
	<a asp-action="Create" class="btn btn-primary plus">+</a>
	<table class="table">
		<thead>
		<th>Потреб. име</th>
		<th>Име</th>
		<th>Фамилия</th>
		<th>Възраст</th>
		</thead>
		<tbody>
			@foreach (var user in Model)
			{
				<tr>
					<td>@user.UserName</td>
					<td>@user.FirstName</td>
					<td>@user.LastName</td>
					<td>@user.Age</td>
					<td>
						
						<form asp-action="Delete" method="post" style="width:fit-content">
							<input type="hidden" name="confirmed_value" id="confirm" />
							<input type="submit" asp-route-id="@user.Id" onclick="ShouldItBeDeleted()" asp-action="Delete" value="Delete" class="btn btn-danger" />
						</form>
						<a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-primary">Edit</a>
					</td>
				</tr>

			}
		</tbody>
	</table>
</main>

<style>
	.plus{
		justify-self: center;
	}
	main{
		margin:0 5% 0 5%;
	}
</style>
