@model IEnumerable<ApplicationUser>

<h2>Users</h2>
<a asp-action="Create">+</a>
<table class="table-bordered">
	<thead>
		<th>Username</th>
		<th>FirstName</th>
		<th>LastName</th>
		<th>Date of Birth</th>
		<th>Actions</th>
	</thead>
	<tbody>
		@foreach(var user in Model)
		{
			<tr>
				<td>@user.UserName</td>
				<td>@user.FirstName</td>
				<td>@user.LastName</td>
				<td>@user.DateOfBirth</td>
				<td>
					<a>Delete</a>
					<br>
					<a>Edit</a>
				</td>
			</tr>
			
		}
	</tbody>
</table>
