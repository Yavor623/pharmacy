@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager
@model IEnumerable<ApplicationUser>
@section Scripts{
	<script type="text/javascript">
		function func() {
			if (confirm("Hi")) {
				$("#confirm").val("Yes");
			}
			else {
				$("#confirm").val("No");
			}
		}
	</script>
}
<h2>Users</h2>
<a asp-action="Create">+</a>
<table class="table-bordered">
	<thead>
		<th>Username</th>
		<th>FirstName</th> 
		<th>LastName</th>
		<th>Age</th>
		<th>Actions</th>
	</thead>
	<tbody> 
		@foreach(var user in Model)
		{
			<tr>
				<td>@user.UserName</td>
				<td>@user.FirstName</td>
				<td>@user.LastName</td>
				<td>@user.Age</td>
				<td>
					@if (!await UserManager.IsInRoleAsync(user,"Admin"))
					{
						<form asp-action="Delete" method="post">
							<input type="hidden" name="confirmed_value" id="confirm" />
							<input type="submit" asp-route-id="@user.Id" onclick="func()" asp-action="Delete"/>
						</form>
						<br>
					}
					<a asp-action="Edit" asp-route-id="@user.Id">Edit</a>
				</td>
			</tr>
			
		}
	</tbody>
</table>

