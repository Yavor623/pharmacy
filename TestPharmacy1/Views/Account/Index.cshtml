@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager
@model IEnumerable<ApplicationUser>

<h2>Users</h2>
<a asp-action="Create">+</a>
<table class="table-bordered">
	<thead>
		<th>Username</th>
		<th>FirstName</th>
		<th>LastName</th>
		<th>Age</th>
		<th>Actions</th>
	</thead>
	<tbody>
		@foreach(var user in Model)
		{
			<tr>
				<td>@user.UserName</td>
				<td>@user.FirstName</td>
				<td>@user.LastName</td>
				<td>@user.Age</td>
				<td>
					@if (!await UserManager.IsInRoleAsync(user,"Admin"))
					{
						<form action="/" method="post">
							<input type="hidden" name="confirm_value" value="" />
							<input type="submit" value="Delete" onclick="Confirm()" asp-action="Delete" asp-route-id="@user.Id" />
						</form>
						<br>
					}
					<a asp-action="Edit" asp-route-id="@user.Id">Edit</a>
				</td>
			</tr>
			
		}
	</tbody>
</table>
