@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager
@model IEnumerable<ApplicationUser>

<main>
	<h2 style="justify-self:center">Потребители</h2>
	<a asp-action="Create" class="btn btn-primary plus">+</a>
	<table class="table">
		<thead>
			<th>Потреб. име</th>
			<th>Име</th>
			<th>Фамилия</th>
			<th>Възраст</th>
			<th></th>
		</thead>
		<tbody>
			@foreach (var user in Model)
			{
				<tr>
					<td>@user.UserName</td>
					<td>@user.FirstName</td>
					<td>@user.LastName</td>
					<td>@user.Age години</td>
					<td>
							<a asp-action="Delete" asp-route-id="@user.Id" class="btn btn-danger">Delete</a>
							<a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-primary">Edit</a>
					</td>
				</tr>

			}
		</tbody>
	</table>
</main>

<style>
	.plus{
		justify-self: center;
	}
	main{
		margin:0 5% 0 5%;
	}
</style>
