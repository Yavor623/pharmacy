@using Microsoft.AspNetCore.Identity
@inject RoleManager<IdentityRole> RoleManager
@model CreateUserViewModel

<main>
    <form asp-action="Create" method="post">
    <h2>Създаване на потребител</h2>
    <div class="form-group">
        <label asp-for="FirstName">Име</label>
        <input asp-for="FirstName" class="form-control"/>
        <span asp-validation-for="FirstName"></span>
    </div class="form-group">
    <div class="form-group">
        <label asp-for="LastName">Фамилия</label>
        <input asp-for="LastName"class="form-control" />
        <span asp-validation-for="LastName"></span>
    </div>
    <div class="form-group">
        <label asp-for="Email">Имейл</label>
        <input asp-for="Email" class="form-control"/>
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Password">Парола</label>
        <input asp-for="Password" class="form-control" />
        <span asp-validation-for="Password" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="ConfirmPassword">Потвърди парола</label>
        <input asp-for="ConfirmPassword"class="form-control" />
        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Age"></label>
        <input asp-for="Age" type="number" min="0" class="form-control"/>
        <span asp-validation-for="Age" class="text-danger"></span>
    </div>
    <br />
    <div>
        <button type="submit" class="btn btn-primary">Създай</button>
    </div>
</form>
</main>



<style>
    main {
        margin:3% 10% 0 10%;
    }
</style>

