@using Microsoft.AspNetCore.Identity
@inject RoleManager<IdentityRole> RoleManager
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@using System.Text
@model EditUserViewModel

<main>
    <form asp-action="Edit" method="post">
        <h2>Редактиране на потребител</h2>
        <div class="form-group">
            <label asp-for="FirstName">Име</label>
            <input asp-for="FirstName" value="@Model.CurrentUser.FirstName" class="form-control" />
            <span asp-validation-for="FirstName" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="LastName">Фамилия</label>
            <input asp-for="LastName" value="@Model.CurrentUser.LastName" class="form-control" />
            <span asp-validation-for="LastName" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="Email">Имейл</label>
            <input asp-for="Email" value="@Model.CurrentUser.Email" class="form-control" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="Age"></label>
            <input asp-for="Age" type="number" min="0" class="form-control" />
            <span asp-validation-for="Age" class="text-danger"></span>
        </div>
        <button type="submit" class="btn btn-primary">Готово</button>
    </form>
</main>



<style>
    main {
        margin: 3% 10% 0 10%;
    }

</style>
