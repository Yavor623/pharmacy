@model TestPharmacy1.Models.Precsription.CreatePrescriptionViewModel
@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager

<main>
	<form asp-action="Create" method="post">
		<div class="form-group">
			<label asp-for="Medications" class=""></label>
			<input asp-for="Medications" class="form-control" />
			<span asp-validation-for="Medications" class="text-danger"></span>
		</div>
		<input type="hidden" asp-for="UserId" value="@UserManager.GetUserId(User)" />
		<div class="form-group">
			<label asp-for="PrescribedDate" class=""></label>
			<input asp-for="PrescribedDate" class="form-control" type="date" />
			<span asp-validation-for="PrescribedDate" class="text-danger"></span>
		</div>
		<div class="form-group">
			<label asp-for="Description" class=""></label>
			<input asp-for="Description" class="form-control" />
			<span asp-validation-for="Description" class="text-danger"></span>
		</div>
		<button type="submit" class="btn btn-success">Запази</button>
	</form>
</main>
<script>
	main{
		margin:3% 5% 0 5%;
	}
</script>