@model IEnumerable<Prescription>
@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
<main>
	<h2 style="justify-self:center">Предписания</h2>
	<a asp-action="Create" class="btn btn-primary">+</a>
	<table class="table">
		<thead>
		<th>Медикаменти</th>
		<th>Дата на предписване</th>
		<th>Описание</th>
		</thead>
		<tbody>
			@foreach (var prescription in Model)
			{
				<tr>
					<td>@prescription.Medications</td>
					<td>@prescription.PrescribedDate</td>
					<td>@prescription.Description</td>
					<td>
						<a asp-action="Delete" asp-route-id="@prescription.PrescriptionId" class="btn btn-danger">Delete</a>
						<a asp-action="Edit" asp-route-id="@prescription.PrescriptionId" class="btn btn-primary">Edit</a>
					</td>
				</tr>

			}
		</tbody>
	</table>
</main>
<style>
	main {
		margin: 0 5% 0 5%;
	}
</style>