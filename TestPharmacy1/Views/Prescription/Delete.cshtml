@model TestPharmacy1.Models.Precsriptions.DeletePrescriptionViewModel
<form asp-action="Delete" typeof="post">
	<h3>Сигурни ли сте че искате да изтриете това предписание?</h3>

	<h4>Медикаменти: @Model.Medications</h4>
	<h4>Дата на предписване: @Model.PrescribedDate</h4>
	<h4>Описание: @Model.Description</h4>

	<button type="submit" asp-route-id="@Model.PrescriptionId" class="btn btn-success" type="post">Да</button>
	<a asp-action="Index" class="btn btn-danger">Не</a>
</form>
<style>
	form {
		margin: 3% 10% 0 10%;
	}
</style>
