@model IEnumerable<OwnedMedication>

@{
    decimal sum = 0;
    foreach(var one in Model){
        sum += one.Amount*one.Medication.Price;
    }
}
<main>
    <h2>Shopping cart</h2>
    <div>
        The sum of it is: @sum
    </div>
    <div id="items" style="margin-left:3%">

        @foreach (var item in Model)
        {
            <div class="items-inner">
                <div style="width:100%">
                    <a asp-action="Delete">Delete</a>
                    <div id="pic-frame">
                        <a asp-action="Details" asp-route-id="@item.Medication.Id" asp-route-prescriptionMessage=""><img src="data:image;base64,@(Convert.ToBase64String(@item.Medication.Image))" style="border-radius:1rem;" /></a>
                    </div>
                    <div style="min-height:50px"><h5 style="font-weight:350">@item.Medication.Name @item.Medication.Description</h5></div>
                    <div style="min-height:50px"><h5 style="font-weight:650;color:lawngreen">@item.Amount x @item.Medication.Price лв.</h5></div>
                </div>
            </div>
        }

    </div> 
</main>

<style>


    a {
        text-decoration: none;
    }

    main {
        margin-top: 5vh;
        width: var(--main-width);
        height: var(--height);
        padding: 3%;
        margin: 0;
        margin: 0 0 0 var( --margin-left-main);
        padding: 0;
        overflow: hidden;
        *

    {
        margin: 0;
        padding: 0;
    }

    }

    #title {
        margin: 10vh 0 5vh 20vw;
    }

    #items {
        width: 95%;
        height: 100%;
        display: grid;
        grid-template-columns: 1fr 1fr 1fr 1fr;
        grid-template-rows: 1fr 1fr 1fr;
    }

    .items-inner {
        height: 100%;
        width: 85%;
        padding: 5%;
    }

        .items-inner:hover {
            border: 1px solid black;
            border-radius: 7px;
        }
</style>