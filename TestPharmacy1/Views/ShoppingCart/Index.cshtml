@model IEnumerable<OwnedMedication>

@{
    decimal sum = 0;
    foreach(var one in Model){
        sum += one.Amount*one.Medication.Price;
    }
}

<aside class="left-aside">
    <h2>Страни</h2>
    <form asp-action="Index" method="get" class="searchId">
        <input name="searchString" value="" type="text" class="searchBar" />
        <input type="submit" value="Search" class="searchBtn" />
        <br />
        <label>Sort by:</label>
        <select name="selectedOption">
            <option></option>
            <option>Price</option>
            <option>Name</option>
        </select>

        <input type="submit" value="Order" />
    </form>
    <br />
    <a asp-action="Create" class="btn btn-primary">Create</a>
</aside>
<main>
    <h2>Shopping cart</h2>
    <div>
        The sum of it is: @sum
    </div>
    <div id="items" style="margin-left:3%">

        @foreach (var item in Model)
        {
            <div class="items-inner">

                <div id="pop-up" style="display:none">
                    <ul>
                        <li><a asp-action="Delete">Delete</a></li>
                        <li><a asp-action="Edit">Edit</a></li>
                    </ul>
                </div>
                <div style="width:100%">
                    <label class="three-dots">&#8230;<input type="checkbox" onclick="" name="toggle" id="toggle" /></label>
                    <div id="pic-frame">
                        <img src="data:image;base64,@(Convert.ToBase64String(@item.Medication.Image))" style="border-radius:1rem;" />
                    </div>
                    <div style="min-height:50px"><h5 style="font-weight:350">@item.Medication.Name @item.Medication.Description</h5></div>
                    <div style="min-height:50px"><h5 style="font-weight:650;color:lawngreen">@item.Amount x @item.Medication.Price лв.</h5></div>
                </div>
            </div>
        }

    </div> 
</main>

<style>
    .searchBar {
        border-radius: 7px;
        border: 1px solid gray;
        margin: 0;
        height: 10%;
        width: 70%;
        padding: 3%;
        font-size: 1.3em;
    }

    .searchBtn {
        border-radius: 7px;
        border: 1px solid transparent;
        color: white;
        margin: 0;
        font-size: 1em;
        font-weight: 400;
        background-color: dodgerblue;
        height: 10%;
        width: 25%;
    }

    .left-aside {
        position: relative;
        float: left;
        margin-left: var(--margin-left-aside);
        width: calc(var( --margin-left-main) - calc(2* var(--margin-left-aside)));
        z-index: 1;
        height: var(--height);
        border: 1px solid black;
        padding: 1%;
    }
    #pop-up {
        width: 100%;
        height: 20%;
        z-index: 2;
        box-shadow: rgb(0, 0, 0,4),4px 4px inset;
    }

        #pop-up li {
            border-bottom: 2px solid gray;
        }

    a {
        text-decoration: none;
    }

    .searchId {
        width: 100%;
        margin: 0;
        height: 70%;
        padding: 5%;
    }
    .three-dots {
        float: right;
        border: none;
        height: 10%;
        width: 100%;
        color: black;
        width: auto;
        background-color: transparent;
        margin: 0;
        margin-bottom: 3%;
        font-size: 1rem;
        z-index: 3;
    }

    main {
        margin-top: 5vh;
        width: var(--main-width);
        height: var(--height);
        padding: 3%;
        margin: 0;
        margin: 0 0 0 var( --margin-left-main);
        padding: 0;
        overflow: hidden;
        *

    {
        margin: 0;
        padding: 0;
    }

    }

    #title {
        margin: 10vh 0 5vh 20vw;
    }

    #items {
        width: 95%;
        height: 100%;
        display: grid;
        grid-template-columns: 1fr 1fr 1fr 1fr;
        grid-template-rows: 1fr 1fr 1fr;
    }

    .items-inner {
        height: 100%;
        width: 85%;
        padding: 5%;
    }

        .items-inner:hover {
            border: 1px solid black;
            border-radius: 7px;
        }
</style>