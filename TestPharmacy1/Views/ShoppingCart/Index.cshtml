@model IEnumerable<OwnedMedication>
<main>
    <h2>Shopping cart</h2>
    <div id="items" style="margin-left:3%">

        @foreach (var item in Model)
        {
            <div class="items-inner">

                <div id="pop-up" style="display:none">
                    <ul>
                        <li><a asp-action="Delete">Delete</a></li>
                        <li><a asp-action="Edit">Edit</a></li>
                    </ul>
                </div>
                <div style="width:100%">
                    <a asp-action="AddToCart" asp-route-id="@item.Id"></a>
                    <label class="three-dots">&#8230;<input type="checkbox" onclick="" name="toggle" id="toggle" /></label>
                    <div id="pic-frame">
                        <img src="data:image;base64,@(Convert.ToBase64String(@item.Medication.Image))" style="border-radius:1rem;" />
                    </div>
                    <div style="min-height:50px"><h5 style="font-weight:350">@item.Medication.Name @item.Medication.Description</h5></div>
                    <div style="min-height:50px"><h5 style="font-weight:650;color:lawngreen">@item.Medication.Price лв.</h5></div>
                </div>
            </div>
        }

    </div>
</main>

<style>
    #pop-up {
        width: 100%;
        height: 20%;
        z-index: 2;
        box-shadow: rgb(0, 0, 0,4),4px 4px inset;
    }

        #pop-up li {
            border-bottom: 2px solid gray;
        }

    a {
        text-decoration: none;
    }

    .three-dots {
        float: right;
        border: none;
        height: 10%;
        width: 100%;
        color: black;
        width: auto;
        background-color: transparent;
        margin: 0;
        margin-bottom: 3%;
        font-size: 1rem;
        z-index: 3;
    }

    main {
        margin-top: 5vh;
        width: var(--main-width);
        height: var(--height);
        padding: 3%;
        margin: 0;
        margin: 0 0 0 var( --margin-left-main);
        padding: 0;
        overflow: hidden;
        *

    {
        margin: 0;
        padding: 0;
    }

    }

    #title {
        margin: 10vh 0 5vh 20vw;
    }

    #items {
        width: 95%;
        height: 100%;
        display: grid;
        grid-template-columns: 1fr 1fr 1fr 1fr;
        grid-template-rows: 1fr 1fr 1fr;
    }

    .items-inner {
        height: 100%;
        width: 85%;
        padding: 5%;
    }

        .items-inner:hover {
            border: 1px solid black;
            border-radius: 7px;
        }
</style>